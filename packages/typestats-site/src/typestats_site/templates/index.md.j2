{% from "_macros.j2" import icon_py_typed, help_link %}
---
hide:
  - navigation
  - path
  - toc
---

# Overview

<div class="filter-bar">
  <span style="font-size: 0.9em; opacity: 0.7">
    Or <a href="report/">view your own report</a>
  </span>
  <button type="button" class="filter-toggle" aria-label="Toggle filters" aria-expanded="false" aria-controls="filter-groups">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/></svg>
  </button>
  <div class="filter-groups" id="filter-groups">
    <div class="filter-group" data-filter="py-typed">
      <span class="filter-label">py.typed</span>
      <button type="button" class="filter-btn filter-btn--active" aria-pressed="true" data-value="all">All</button>
      <button type="button" class="filter-btn" aria-pressed="false" data-value="1">Yes</button>
      <button type="button" class="filter-btn" aria-pressed="false" data-value="0">No</button>
    </div>
    <div class="filter-group" data-filter="stubs">
      <span class="filter-label">Has stubs</span>
      <button type="button" class="filter-btn filter-btn--active" aria-pressed="true" data-value="all">All</button>
      <button type="button" class="filter-btn" aria-pressed="false" data-value="1">Yes</button>
      <button type="button" class="filter-btn" aria-pressed="false" data-value="0">No</button>
    </div>
    <div class="filter-group filter-group--range" data-filter="coverage">
      <span class="filter-label">Coverage</span>
      <span class="range-value" data-range-min>0%</span>
      <div class="range-slider">
        <input type="range" min="0" max="100" value="0" step="1" data-thumb="min" aria-label="Minimum coverage">
        <input type="range" min="0" max="100" value="100" step="1" data-thumb="max" aria-label="Maximum coverage">
      </div>
      <span class="range-value" data-range-max>100%</span>
    </div>
  </div>
</div>

<table data-dashboard>
  <thead>
    <tr>
      <th><abbr title="PyPI package name">Package</abbr></th>
      <th><abbr title="Latest release version">Version</abbr></th>
      <th><abbr title="Release date on PyPI">Released</abbr></th>
      <th style="text-align: right" data-sort-method="number"><abbr title="Monthly downloads from PyPI">Downloads</abbr></th>
      <th style="text-align: right; white-space: nowrap"><abbr title="Percentage of typed symbols">Coverage</abbr> {{ help_link("../reference/metrics/", "What is coverage?") }}</th>
      <th style="text-align: right; white-space: nowrap"><abbr title="Percentage of typed symbols, excluding Any">Coverage (strict)</abbr> {{ help_link("../reference/metrics/", "What is strict coverage?") }}</th>
      <th style="text-align: right; white-space: nowrap"><abbr title="Number of public typable slots: each function parameter, return type, and variable counts as one">Typables</abbr> {{ help_link("../reference/metrics/", "What are typables?") }}</th>
      <th class="num"><abbr title="PEP 561 py.typed marker">py.typed</abbr></th>
      <th><abbr title="Type info from a standalone stubs package">Stubs</abbr></th>
    </tr>
  </thead>
  <tbody>
    {% for r in rows %}
      <tr data-py-typed="{{ '1' if r.py_typed != 'no' else '0' }}"
          data-stubs="{{ '1' if r.stubs_link else '0' }}"
          data-coverage="{{ r.coverage_num }}"
          data-coverage-strict="{{ r.coverage_strict_num }}">
        <td><a href="report/#{{ r.package }}">{{ r.package }}</a></td>
        <td class="num">{{ r.version }}</td>
        <td class="num">{{ r.release_date }}</td>
        <td class="num pypi-downloads" data-package="{{ r.package }}" style="text-align: right"></td>
        <td class="num" style="text-align: right">{{ r.coverage }}</td>
        <td class="num" style="text-align: right">{{ r.coverage_strict }}</td>
        <td class="num" style="text-align: right">{{ r.n_typable }}</td>
        <td class="num"><span hidden>{{ r.py_typed_sort }}</span>{{ icon_py_typed(r.py_typed) }}</td>
        {% if r.stubs_link %}
        <td><a href="report/#{{ r.stubs_link }}">{{ r.stubs_link }}</a></td>
        {% else %}
        <td></td>
        {% endif %}
      </tr>
    {% endfor %}
  </tbody>
</table>
