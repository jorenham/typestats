{% from "_macros.j2" import metric_cell %}
---
hide:
  - navigation
  - toc
---

# {{ package }} Version History

{% if chart %}
!!! info "Coverage timeline"

    ``` mermaid
    ---
    config:
        xyChart:
            width: 1600
            height: 320
            xAxis:
                labelPadding: 16
        themeVariables:
            xyChart:
                plotColorPalette: "{{ chart.palette }}"
                backgroundColor: "transparent"
    {% for key in chart.theme_colors %}
                {{ key }}: "currentColor"
    {% endfor %}
    ---
    xychart-beta
        x-axis [{{ chart.labels | map('tojson') | join(', ') }}]
        y-axis "Coverage (%)" 0 --> 100
        line [{{ chart.cov | join(', ') }}]
        line [{{ chart.strict_cov | join(', ') }}]
    ```

    <div class="chart-legend" markdown>
      <span class="chart-legend-item">
        <span class="chart-legend-swatch chart-legend-swatch--cov"></span> Coverage
      </span>
      <span class="chart-legend-item">
        <span class="chart-legend-swatch chart-legend-swatch--strict"></span> Coverage (strict)
      </span>
    </div>
{% endif %}

<table>
  <thead>
    <tr>
      <th>Version</th>
      <th style="text-align: right">
        <abbr title="Release date on PyPI">Released</abbr>
      </th>
      <th style="text-align: right">
        <abbr title="Percentage of typed symbols">Coverage</abbr>
      </th>
      <th style="text-align: right">
        <abbr title="Percentage of typed symbols, excluding Any">Coverage (strict)</abbr>
      </th>
      <th style="text-align: right">
        <abbr title="Number of public typable slots: each function parameter, return type, and variable counts as one">Typables</abbr>
      </th>
      <th style="text-align: right">
        <abbr title="Slots without a type annotation">Untyped</abbr>
      </th>
      <th style="text-align: right">
        <abbr title="Number of type-checker ignore comments">Ignores</abbr>
      </th>
    </tr>
  </thead>
  <tbody>
    {% for row in rows %}
      <tr>
        {% if loop.first %}
          <td><a href="../">{{ row.version }}{% if row.base_version %} ({{ row.base_version }}){% endif %}</a></td>
        {% else %}
          <td>{{ row.version }}{% if row.base_version %} ({{ row.base_version }}){% endif %}</td>
        {% endif %}
        <td style="text-align: right">{{ row.release_date }}</td>
        {{ metric_cell(row.coverage) }}
        {{ metric_cell(row.coverage_strict) }}
        {{ metric_cell(row.typables) }}
        {{ metric_cell(row.untyped) }}
        {{ metric_cell(row.ignores) }}
      </tr>
    {% endfor %}
  </tbody>
</table>
