{% from "_macros.j2" import icon_py_typed, icon_incomplete %}
---
hide:
  - navigation
  - path
---

# {{ report.package }} {{ report.version }}

<table>
  <tr>
    <td>PyPI</td>
    <td><a href="{{ project_urls.pypi }}">{{ project_urls.pypi }}</a></td>
  </tr>
  {% if project_urls.repo %}
    <tr>
      <td>Repository</td>
      <td><a href="{{ project_urls.repo }}">{{ project_urls.repo }}</a></td>
    </tr>
  {% endif %}
</table>

<div class="grid cards" markdown>

-   __Coverage__

    ---

    {{ coverage }} coverage · {{ strict_coverage }} strict

-   __Symbols__

    ---

    {{ report.n_annotatable }} total · {{ report.n_annotated }} annotated · {{ report.n_any }} Any · {{ report.n_unannotated }} unannotated

-   __Definitions__

    ---

    {{ report.n_functions }} functions ({{ report.n_function_overloads }} overloads) · {{ report.n_methods }} methods ({{ report.n_method_overloads }} overloads) · {{ report.n_classes }} classes · {{ report.n_names }} names · {{ report.n_properties }} properties

-   __Metadata__

    ---

    `py.typed`: {{ icon_py_typed(py_typed) }}{% if stubs_only_label %} · Stubs-only: {{ stubs_only_label }}{% endif %}

</div>

{% if diff_link %}[Version history]({{ diff_link }})
{% else %}
No version history available.
{% endif %}

## Modules

{{ report.n_modules }} modules

<table>
  <thead>
    <tr>
      <th>Module</th>
      <th style="text-align: right"><abbr title="Percentage of annotated symbols">Coverage</abbr></th>
      <th style="text-align: right"><abbr title="Percentage of annotated symbols, excluding Any">Coverage (strict)</abbr></th>
      <th style="text-align: right"><abbr title="Number of public annotatable slots: each function parameter, return type, and variable counts as one">Symbols</abbr></th>
      <th style="text-align: right"><abbr title="Number of type-checker ignore comments">Ignores</abbr></th>
    </tr>
  </thead>
  <tbody>
    {% for m in modules %}
      <tr>
        <td>
          <code>{{ m.display_name }}</code>
          {%- if m.slug %}
            <a href="#{{ m.slug }}" title="Incomplete annotations">{{ icon_incomplete() }}</a>
          {%- endif %}
        </td>
        <td style="text-align: right">{{ m.coverage }}</td>
        <td style="text-align: right">{{ m.coverage_strict }}</td>
        <td style="text-align: right">{{ m.n_annotatable }}</td>
        <td style="text-align: right">{{ m.n_type_ignores }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

## Incomplete Annotations

{% if annotation_sections %}
{% for section in annotation_sections %}
<span id="{{ section.slug }}"></span>
??? "{{ section.display_name }} ({{ section.n_issues }} symbol{{ 's' if section.n_issues != 1 else '' }})"
    <table>
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Kind</th>
          <th>Status</th>
          <th style="text-align: right"><abbr title="Slots with a type annotation">Annotated</abbr></th>
          <th style="text-align: right"><abbr title="Slots typed as Any">Any</abbr></th>
          <th style="text-align: right"><abbr title="Slots without a type annotation">Unannotated</abbr></th>
        </tr>
      </thead>
      <tbody>
        {% for row in section.rows %}
          <tr>
            <td><code>{{ row.name }}</code></td>
            <td>{{ row.kind }}</td>
            <td>{{ row.status }}</td>
            <td style="text-align: right">{{ row.n_annotated }}</td>
            <td style="text-align: right">{{ row.n_any }}</td>
            <td style="text-align: right">{{ row.n_unannotated }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

{% endfor %}
{% else %}
All symbols are fully annotated. :tada:

{% endif %}

## Type-Ignore Comments

{% if type_ignores %}
<table>
  <thead>
    <tr>
      <th><abbr title="Type-checker ignore directive">Flavor</abbr></th>
      <th style="text-align: right">Count</th>
    </tr>
  </thead>
  <tbody>
    {% for flavor, count in type_ignores %}
      <tr>
        <td><code>{{ flavor }}</code></td>
        <td style="text-align: right">{{ count }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
No type-ignore comments.

{% endif %}
