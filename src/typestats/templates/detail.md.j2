{% from "_macros.j2" import icon_py_typed, icon_incomplete %}
---
hide:
  - navigation
  - path
---

# {{ report.package }} {{ report.version }}

{% if diff_link %}[Version history]({{ diff_link }}){% if json_url %} | {% endif %}{% endif %}
{%- if json_url %}[Download JSON]({{ json_url }}){% endif %}
{% if not diff_link and not json_url %}
No version history available.
{% endif %}

<div class="grid cards" markdown>

-   <table>
      <tr>
      <td>PyPI</td>
      <td><a href="{{ project_urls.pypi }}">{{ project_urls.pypi }}</a></td>
      </tr>{% if project_urls.repo %}
      <tr>
      <td>Repository</td>
      <td><a href="{{ project_urls.repo }}">{{ project_urls.repo }}</a></td>
      </tr>{% endif %}
    </table>

-   <table>
      <tr>
      <td><code>py.typed</code></td>
      <td>{{ icon_py_typed(py_typed) }}</td>
      </tr>{% if stubs_only_label %}
      <tr>
      <td>stubs-only</td>
      <td>{{ stubs_only_label }}</td>
      </tr>{% endif %}
    </table>


-   __Coverage__

    ---

    ```mermaid
    %%{init: {{ mermaid_config_pie | tojson }}}%%
    pie title
        "Typed" : {{ report.n_typed }}
        "Any" : {{ report.n_any }}
        "Untyped" : {{ report.n_untyped }}
    ```

    - {{ coverage }} coverage
    - {{ strict_coverage }} strict coverage (excluding `Any`)
    - {{ report.n_typable }} typable
        - {{ report.n_typed }} typed
        - {{ report.n_untyped }} untyped
        - {{ report.n_any }} `Any`

-   __Definitions__

    ---

    ```mermaid
    %%{init: {{ mermaid_config_pie | tojson }}}%%
    pie title
        "functions" : {{ symbols_by_kind.functions }}
        "classes" : {{ symbols_by_kind.classes }}
        "other" : {{ symbols_by_kind.names }}
    ```

    - {{ report.n_functions }} functions (+{{ report.n_function_overloads - report.n_functions }} overloads)
        - {{ report.n_function_params }} parameters
    - {{ report.n_classes }} classes
        - {{ report.n_methods }} methods (+{{ report.n_method_overloads - report.n_methods }} overloads)
            - {{ report.n_method_params }} parameters
        - {{ report.n_properties }} properties
    - {{ report.n_modules }} modules
        - {{ report.n_names }} names ({{ symbols_by_kind.names }} typables)

</div>

## Modules

<table>
  <thead>
    <tr>
      <th>Module</th>
      <th style="text-align: right"><abbr title="Percentage of typed symbols">Coverage</abbr></th>
      <th style="text-align: right"><abbr title="Percentage of typed symbols, excluding Any">Coverage (strict)</abbr></th>
      <th style="text-align: right"><abbr title="Number of public typable slots: each function parameter, return type, and variable counts as one">Symbols</abbr></th>
      <th style="text-align: right"><abbr title="Number of type-checker ignore comments">Ignores</abbr></th>
    </tr>
  </thead>
  <tbody>
    {% for m in modules %}
      <tr>
        <td>
          <code>{{ m.display_name }}</code>
          {%- if m.slug %}
            <a href="#{{ m.slug }}" title="Incomplete annotations">{{ icon_incomplete() }}</a>
          {%- endif %}
        </td>
        <td style="text-align: right">{{ m.coverage }}</td>
        <td style="text-align: right">{{ m.coverage_strict }}</td>
        <td style="text-align: right">{{ m.n_typable }}</td>
        <td style="text-align: right">{{ m.n_type_ignores }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

## Incomplete Annotations

{% if annotation_sections %}
{% for section in annotation_sections %}
<span id="{{ section.slug }}"></span>
??? "{{ section.display_name }} ({{ section.n_issues }} symbol{{ 's' if section.n_issues != 1 else '' }})"
    <table>
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Kind</th>
          <th>Status</th>
          <th style="text-align: right"><abbr title="Slots with a type annotation">Typed</abbr></th>
          <th style="text-align: right"><abbr title="Slots typed as Any">Any</abbr></th>
          <th style="text-align: right"><abbr title="Slots without a type annotation">Untyped</abbr></th>
        </tr>
      </thead>
      <tbody>
        {% for row in section.rows %}
          <tr>
            <td><code>{{ row.name }}</code></td>
            <td>{{ row.kind }}</td>
            <td>{{ row.status }}</td>
            <td style="text-align: right">{{ row.n_typed }}</td>
            <td style="text-align: right">{{ row.n_any }}</td>
            <td style="text-align: right">{{ row.n_untyped }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

{% endfor %}
{% else %}
All symbols are fully typed. :tada:

{% endif %}

## Type-Ignore Comments

{% if type_ignores %}
<table>
  <thead>
    <tr>
      <th><abbr title="Type-checker ignore directive">Flavor</abbr></th>
      <th style="text-align: right">Count</th>
    </tr>
  </thead>
  <tbody>
    {% for flavor, count in type_ignores %}
      <tr>
        <td><code>{{ flavor }}</code></td>
        <td style="text-align: right">{{ count }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
No type-ignore comments.

{% endif %}
