{
  "excludes": ["**/*.lock", "dist/"],
  "biome": {
    "lineWidth": 88,
    "indentStyle": "space",
    "semicolons": "asNeeded",
    "arrowParentheses": "asNeeded"
  },
  "json": {
    "array.preferSingleLine": true,
    "lineWidth": 88
  },
  "markdown": {
    "emphasisKind": "asterisks",
    "lineWidth": 88
  },
  "toml": {
    "lineWidth": 88
  },
  "yaml": {
    "braceSpacing": false,
    "formatComments": true,
    "printWidth": 88
  },
  "plugins": [
    "npm:@dprint/biome@0.13.8",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.22.1",
    "npm:@dprint/toml@0.8.0"
  ]
}
